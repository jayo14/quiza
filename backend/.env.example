# --- App ---
APP_NAME=Quiza
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Local dev uses SQLite. Swap to a Postgres URL in production
# (e.g. postgresql+psycopg://user:pass@host:5432/quiza) to enable pgvector.
DATABASE_URL=sqlite:///./quiza.db

# --- Auth / JWT ---
# Must be overridden with a long random value in any non-development environment.
JWT_SECRET_KEY=change-me-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- AI Providers & Failover Chain ---
LLM_PROVIDER_PRIORITY=gemini,openai,nvidia
LLM_MODEL_COOLDOWN_SECONDS=60

# Google Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash,gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODELS=gpt-4o-mini,gpt-4o

# NVIDIA BUILD NIM
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_FALLBACK_MODELS=meta/llama-3.3-70b-instruct,mistralai/mistral-large-2-instruct,deepseek-ai/deepseek-r1

# --- Storage ---
# "local" stores files on disk under STORAGE_DIR. Swap for an s3 implementation later.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# --- Vector store ---
# "sqlite" does brute-force cosine search in-process, fine for local dev / small corpora.
# "pgvector" requires DATABASE_URL to point at Postgres with the pgvector extension.
VECTOR_STORE_BACKEND=sqlite

# --- Rate limiting (basic in-memory limiter for expensive AI endpoints) ---
AI_RATE_LIMIT_PER_MINUTE=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
