# --- App ---
APP_NAME=Quiza
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# Local dev uses SQLite. Swap to a Postgres URL in production
# (e.g. postgresql+psycopg://user:pass@host:5432/quiza) to enable pgvector.
DATABASE_URL=sqlite:///./quiza.db

# --- Auth / JWT ---
# Must be overridden with a long random value in any non-development environment.
JWT_SECRET_KEY=change-me-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Storage ---
# "local" stores files on disk under STORAGE_DIR. Swap for an s3 implementation later.
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# --- Vector store ---
# "sqlite" does brute-force cosine search in-process, fine for local dev / small corpora.
# "pgvector" requires DATABASE_URL to point at Postgres with the pgvector extension.
VECTOR_STORE_BACKEND=sqlite

# --- Rate limiting (basic in-memory limiter for expensive AI endpoints) ---
AI_RATE_LIMIT_PER_MINUTE=10

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
